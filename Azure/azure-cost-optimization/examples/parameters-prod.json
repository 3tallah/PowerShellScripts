{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "automationAccountName": {
            "value": "automation-cost-optimization-prod"
        },
        "location": {
            "value": "eastus"
        },
        "mysqlResourceGroupName": {
            "value": "rg-mysql-prod"
        },
        "mysqlServerName": {
            "value": "mysql-server-prod"
        },
        "mysqlScaleUpSku": {
            "value": "Standard_D4ads_v5"
        },
        "mysqlScaleUpTier": {
            "value": "GeneralPurpose"
        },
        "mysqlScaleDownSku": {
            "value": "Standard_B2s"
        },
        "mysqlScaleDownTier": {
            "value": "Burstable"
        },
        "vmResourceGroupName": {
            "value": "rg-vm-prod"
        },
        "vmName": {
            "value": "vm-app-prod"
        },
        "vmScaleUpSize": {
            "value": "Standard_D4s_v5"
        },
        "vmScaleDownSize": {
            "value": "Standard_B2s"
        },
        "scaleUpTime": {
            "value": "06:00"
        },
        "scaleDownTime": {
            "value": "22:00"
        },
        "webhookUri": {
            "value": "https://prod-webhook.azure.com/your-webhook-endpoint"
        },
        "tags": {
            "value": {
                "Environment": "Production",
                "Purpose": "CostOptimization",
                "ManagedBy": "Automation",
                "CostCenter": "IT-Operations"
            }
        }
    }
}
